---
import { Image } from 'astro:assets'
import Layout from '$layouts/Layout.astro'
import Split from '$components/Split.astro'
import Title from '$components/Title.astro'
import Link from '$components/Link.astro'
import { ad, adsFor } from '$utils/data-ads'
import imgTrofeo from '$assets/images/biznaga/trofeo.webp'
import imgFamilia from '$assets/images/biznaga/familia.webp'
import imgSalvador from '$assets/images/biznaga/salvador-jimenez.webp'

const title = 'Biznaga de Plata'
const variation = 3
const linkPrev = { name: 'Revista de Feria', path: '/revista-de-feria' }
const linkNext = { name: 'Carteles de Feria', path: '/carteles-de-feria' }
const linkPrevMobile = { name: 'Revista de Feria', path: '/revista-de-feria' }
const linkNextMobile = { name: 'Carteles de Feria', path: '/carteles-de-feria' }
const ads = [ad(59)]
const adsMobile = adsFor(60, 61)
---

<Layout {title} {variation} {linkPrev} {linkNext} {linkPrevMobile} {linkNextMobile} {adsMobile}>
	<Split {variation} {ads} reverse>
		<div class="mx-auto 2xl:max-w-2xl">
			<Title class="text-center text-blue-600">La Biznaga de Plata 2026</Title>
			<Image class="my-12 w-full rounded" src={imgTrofeo} width={672} densities={[2]} alt="La Biznaga de Plata de COPE Málaga" />
			<div class="prose my-12">
				<p>
					Desde 1995, en COPE Málaga reconocemos a las personas y entidades que, con su esfuerzo y dedicación, hacen que nuestra feria sea cada vez mejor,
					entregándoles la Biznaga de Plata. Hasta ahora hemos otorgado 29 galardones, un premio que celebra la excelencia y el esfuerzo en hacer de la Feria de
					Málaga un evento inolvidable.
				</p>
				<p>
					Por tercer año consecutivo, la elección de los premiados la dejamos en manos de nuestros oyentes para que voten y decidan la persona o entidad que
					debe recibir este reconocimiento en 2026.
				</p>
			</div>

			<div class="mb-12 grid gap-6 sm:grid-cols-2">
				<figure>
					<Image class="w-full rounded" src={imgSalvador} width={400} densities={[2]} alt="" />
					<figcaption class="mt-2 text-sm text-neutral-500">Salvador Jiménez recibe la Biznaga de Plata 2025 del alcalde, Francisco de la Torre.</figcaption>
				</figure>
				<figure>
					<Image class="w-full rounded" src={imgFamilia} width={400} densities={[2]} alt="" />
					<figcaption class="mt-2 text-sm text-neutral-500">Foto de familia de la entrega de la Biznaga de Plata 2025.</figcaption>
				</figure>
			</div>

			<div class="bg-blue-100 p-6 text-center xl:p-12">
				<h2 class="text-2xl">Te presentamos a los tres candidatos a la Biznaga de Plata 2026</h2>
				<p class="my-6 text-lg font-bold text-neutral-500">Vota por tu favorito</p>
				<Link class="text-blue-600" href="/biznaga-de-plata/votaciones">Ver opciones</Link>
			</div>
		</div>
	</Split>
</Layout>
