---
import Layout from '$layouts/Layout.astro'
import Split from '$components/Split.astro'
import Title from '$components/Title.astro'
import Link from '$components/Link.astro'
import { ad, adsForMobile } from '$utils/data-ads'

const title = 'Curiosidades'
const variation = 3
const linkPrev = { name: 'Saludos', path: '/saludos' }
const linkNext = { name: 'Te lo cuenta COPE', path: '/te-lo-cuenta' }
const linkPrevMobile = { name: 'Saludos', path: '/saludos' }
const linkNextMobile = { name: 'Te lo cuenta COPE', path: '/te-lo-cuenta' }
const ads = [ad(31)]
const adsMobile = adsForMobile(ads)
---

<Layout {title} {variation} {linkPrev} {linkNext} {linkPrevMobile} {linkNextMobile} {adsMobile}>
	<Split {variation} {ads} reverse>
		<div class="mx-auto max-w-4xl">
			<Title class="text-center text-blue-600">Curiosidades de la Feria de Málaga</Title>
			<div class="prose my-12">
				<p>¿Cómo era el primer cartel de la feria de Málaga? ¿Por qué se monta una portada en la calle Larios? ¿Quién fue el primer pregonero de la feria?</p>
				<p>
					El historiador y presidente de la Asociación Cultural Zegrí, <strong>Salvador Jiménez</strong>, nos invita a descubrir la historia de algunos momentos
					que siguen marcando la celebración de la feria de Málaga hoy en día.
				</p>
				<p>Además, repasamos algunas de las curiosidades más desconocidas de la mejor fiesta del sur de Europa.</p>
				<p><strong>Una sección para aprender, disfrutar… y presumir de feria con conocimiento.</strong></p>
			</div>
			<Link class="text-blue-600" href="/curiosidades/videos">Ver vídeos</Link>
		</div>
	</Split>
</Layout>
