---
import { Image } from 'astro:assets'
import Layout from '$layouts/Layout.astro'
import AdSlot from '$components/AdSlot.astro'
import { showAds } from '$utils/config'
import ad28 from '$assets/images/ads/ad-28.gif'
import ad29 from '$assets/images/ads/ad-29.jpg'
import ad29video from '$assets/videos/ads/casino.mp4'

const title = 'Publicidad 3'
const variation = 1
const linkPrev = { name: 'Plaza de Toros', path: '/plaza-de-toros' }
const linkNext = { name: '60 Aniversario', path: '/60-aniversario' }
const linkPrevMobile = { name: 'Plaza de Toros', path: '/plaza-de-toros' }
const linkNextMobile = { name: '60 Aniversario', path: '/60-aniversario' }

const slots = [
	{ spot: 84, image: ad28, url: 'https://metromalaga.es/' },
	{ spot: 85, image: ad29, video: ad29video },
]
---

<Layout {title} {variation} {linkPrev} {linkNext} {linkPrevMobile} {linkNextMobile}>
	<span class="absolute inset-0 bg-blue-600"></span>
	<div class="container relative py-24 text-white">
		<div class="grid gap-12 md:grid-cols-2 xl:gap-24">
			{
				slots.map(({ spot, image, video, url }) => (
					<div class="mx-auto max-w-144">
						<p>{showAds ? 'En colaboración con' : 'Publicidad'}</p>
						{!showAds ? (
							<AdSlot class="mt-3" spot={spot} video={!!video} />
						) : video ? (
							<a class="open-in-modal group" target="_blank" href={video}>
								<Image class="mt-3 aspect-square rounded object-cover" src={image} width={576} densities={[2]} alt="" />
							</a>
						) : (
							<a target="_blank" href={url}>
								<Image class="mt-3 aspect-square rounded object-cover" src={image} width={576} densities={[2]} alt="" />
							</a>
						)}
					</div>
				))
			}
		</div>
	</div>
</Layout>
