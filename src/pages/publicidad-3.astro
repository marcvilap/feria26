---
import { Image } from 'astro:assets'
import Layout from '$layouts/Layout.astro'
import ad28 from '$assets/images/ads/ad-28.gif'
import ad29 from '$assets/images/ads/ad-29.jpg'
import ad26video from '$assets/videos/ads/casino.mp4'

const title = 'Publicidad 3'
const variation = 1
const linkPrev = { name: '150 Años la Malagueta', path: '/150-anos-la-malagueta' }
const linkNext = { name: 'Feria Taurina', path: '/feria-taurina' }
const linkPrevMobile = { name: '150 Años la Malagueta', path: '/150-anos-la-malagueta' }
const linkNextMobile = { name: 'Feria Taurina', path: '/feria-taurina' }
---

<Layout {title} {variation} {linkPrev} {linkNext} {linkPrevMobile} {linkNextMobile}>
	<span class="absolute inset-0 bg-blue-600"></span>
	<div class="container relative py-24 text-white">
		<div class="grid gap-12 md:grid-cols-2 xl:gap-24">
			<div class="mx-auto max-w-144">
				<p>En colaboración con</p>
				<a target="_blank" href="https://metromalaga.es/">
					<Image class="mt-3 aspect-square rounded object-cover" src={ad28} width={576} densities={[2]} alt="" />
				</a>
			</div>
			<div class="mx-auto max-w-144">
				<p>En colaboración con</p>
				<a class="open-in-modal group" target="_blank" href={ad26video}>
					<Image class="mt-3 aspect-square rounded object-cover" src={ad29} width={576} densities={[2]} alt="" />
				</a>
			</div>
		</div>
	</div>
</Layout>
