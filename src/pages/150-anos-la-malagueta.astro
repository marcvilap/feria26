---
import { Image } from 'astro:assets'
import Layout from '$layouts/Layout.astro'
import Title from '$components/Title.astro'
import Icon from '$components/Icon.astro'
import imgBull from '$assets/images/bull.webp'
import timeline from '$utils/data-timeline'
import ad01 from '$assets/images/ads/ad-01.jpg'
import ad27 from '$assets/images/ads/ad-27.jpg'
import ad28 from '$assets/images/ads/ad-28.gif'

const title = '150 Años la Malagueta'
const variation = 1
const linkPrev = { name: 'Mapa Interactivo', path: '/mapa-interactivo' }
const linkNext = { name: 'Feria Taurina', path: '/publicidad-3' }
const linkPrevMobile = { name: 'Mapa Interactivo', path: '/mapa-interactivo' }
const linkNextMobile = { name: 'Feria Taurina', path: '/feria-taurina' }
const adsMobile = [
	{ image: ad27, url: 'https://www.concesionarios.seat/overview-dw.dealer.automoviles-rueda.html' },
	{ image: ad28, url: 'https://metromalaga.es' },
]
---

<Layout {title} {variation} {linkPrev} {linkNext} {linkPrevMobile} {linkNextMobile} {adsMobile}>
	<section class="reveal relative -mt-20 bg-black text-white lg:-mt-24">
		<Image class="absolute left-0 top-0 size-full object-cover opacity-25 max-lg:blur" src={imgBull} width={1920} densities={[2]} alt="" />
		<div class="container relative flex min-h-svh flex-col justify-between gap-y-12 pb-12 pt-36 lg:pb-24 lg:pt-48">
			<div class="grid gap-12 lg:grid-cols-2 xl:gap-24">
				<div>
					<Title>La Malagueta, una plaza de toros con 150 años de historia</Title>
					<p class="mt-6 max-w-[31rem] text-lg font-bold reveal:translate-y-24 reveal:opacity-0 revealed:delay-[.4s]">
						En 1874 comenzaba la construcción del coso taurino de la capital de la Costa del Sol, por el que hacemos un repaso histórico a través de una
						selección fotográfica
					</p>
				</div>
				<div class="max-lg:hidden">
					<div class="rounded bg-white/10 p-6 backdrop-blur reveal:translate-x-24 reveal:opacity-0 revealed:delay-[.6s]">
						<Image id="timeline-img" class="aspect-video w-full rounded object-cover" src={timeline[0].image} width="720" alt="" />
						<p id="timeline-desc" class="mt-4">{timeline[0].description}</p>
					</div>
				</div>
			</div>

			<div class="grid gap-6 sm:grid-cols-2 lg:flex lg:items-center lg:gap-0">
				{
					timeline.map(({ image, year, title, description }, index) => [
						index > 0 && <div class="grow border-t border-white max-lg:hidden" />,

						<article class="group relative">
							<button class="set-timeline flex size-8 items-center justify-center rounded-full bg-white/10 p-2 backdrop-blur max-lg:hidden">
								<Icon class="w-3" name="document" />
							</button>

							<div class="relative rounded bg-white/10 p-6 backdrop-blur lg:invisible lg:absolute lg:bottom-full lg:left-1/2 lg:-ml-32 lg:mb-6 lg:flex lg:w-64 lg:gap-6 lg:opacity-0 lg:transition-all lg:group-hover:visible lg:group-hover:opacity-100">
								<div class="lg:order-2">
									<h3 class="font-bold text-blue-600">{year}</h3>
									<h2 class="text-xl font-bold">{title}</h2>
									<Icon class="absolute right-6 top-6 w-4 shrink-0 text-blue-600" name="document" />
								</div>
								<Image class="aspect-video w-full rounded object-cover max-lg:my-3 lg:aspect-square lg:w-16" src={image} width="720" densities={[2]} alt="" />
								<p class="lg:hidden">{description}</p>
								<span class="absolute left-1/2 top-full -ml-4 border-x-[1rem] border-t-[1rem] border-x-transparent border-t-white/10 backdrop-blur max-lg:hidden" />
							</div>
						</article>,
					])
				}
			</div>
		</div>
	</section>
</Layout>
