---
import { Image } from 'astro:assets'
import Layout from '$layouts/Layout.astro'
import AdSlot from '$components/AdSlot.astro'
import { showAds } from '$utils/config'
import ad08 from '$assets/images/ads/ad-08.png'
import ad09 from '$assets/images/ads/ad-09.gif'

import ad08video from '$assets/videos/ads/molina.mp4'
import ad09video from '$assets/videos/ads/fenie.mp4'

const title = 'Publicidad 1'
const variation = 1
const linkPrev = { name: 'Saludos', path: '/saludos' }
const linkNext = { name: 'Curiosidades', path: '/curiosidades' }
const linkPrevMobile = { name: 'Saludos', path: '/saludos' }
const linkNextMobile = { name: 'Curiosidades', path: '/curiosidades' }

const slots = [
	{ spot: 29, image: ad08, video: ad08video },
	{ spot: 30, image: ad09, video: ad09video },
]
---

<Layout {title} {variation} {linkPrev} {linkNext} {linkPrevMobile} {linkNextMobile}>
	<span class="absolute inset-0 bg-blue-600"></span>
	<div class="container relative py-24 text-white">
		<div class="grid gap-12 md:grid-cols-2 xl:gap-24">
			{
				slots.map(({ spot, image, video }) => (
					<div class="mx-auto max-w-144">
						<p>{showAds ? 'En colaboración con' : 'Publicidad'}</p>
						{showAds ? (
							<a class="open-in-modal group" target="_blank" href={video}>
								<Image class="mt-3 aspect-square rounded object-cover" src={image} width={576} densities={[2]} alt="" />
							</a>
						) : (
							<AdSlot class="mt-3" spot={spot} video={!!video} />
						)}
					</div>
				))
			}
		</div>
	</div>
</Layout>
