---
import Layout from '$layouts/Layout.astro'
import Split from '$components/Split.astro'
import Title from '$components/Title.astro'
import VideoGrid from '$components/VideoGrid.astro'
import { ad, adsFor } from '$utils/data-ads'
import videoVino from '$assets/videos/vino/vino-feria.mp4'
import videoCasaGuardia from '$assets/videos/vino/casa-de-guardia.mp4'
import imageVino from '$assets/images/posters-video/vino/vino-feria.webp'
import imageCasaGuardia from '$assets/images/posters-video/vino/casa-de-guardia.webp'

const title = 'El vino y la Feria'
const variation = 3
const linkPrev = { name: '60 Aniversario', path: '/60-aniversario' }
const linkNext = { name: 'Revista de Feria', path: '/revista-de-feria' }
const linkPrevMobile = { name: '60 Aniversario', path: '/60-aniversario' }
const linkNextMobile = { name: 'Revista de Feria', path: '/revista-de-feria' }
const ads = [ad(73)]
const adsMobile = adsFor(74, 75)
// Un hueco por vídeo de la parrilla, en el mismo orden.
const modalSpots = [76, 77]
const modalAds = adsFor(...modalSpots)

const videos = [
	{ image: imageVino, video: videoVino, name: 'El vino en la Feria de Málaga' },
	{ image: imageCasaGuardia, video: videoCasaGuardia, name: 'Antigua Casa de Guardia' },
]
---

<Layout {title} {variation} {linkPrev} {linkNext} {linkPrevMobile} {linkNextMobile} {adsMobile} {modalAds}>
	<Split {variation} {ads} reverse>
		<Title class="text-blue-600">El vino en la Feria de Málaga</Title>
		<div class="prose my-12 max-w-2xl">
			<p>
				El <strong>Cartojal</strong> es el vino más emblemático de la Feria de Málaga. Elaborado por Bodegas Málaga Virgen con uva Moscatel de Alejandría, destaca
				por su sabor dulce y fresco. Aun así, la feria ofrece mucho más: en la provincia se elaboran más de 100 vinos que también pueden degustarse durante estos
				días.
			</p>
			<p>
				Para profundizar en la cultura vitivinícola malagueña, merece la pena visitar el <strong>Museo del Vino Málaga</strong>, ubicado en el antiguo Palacio
				de Biedmas, un edificio del siglo XVIII.
			</p>
		</div>
		<VideoGrid adSpot={modalSpots} items={videos} columns={2} />
	</Split>
</Layout>
