---
import { Image } from 'astro:assets'
import Layout from '$layouts/Layout.astro'
import Split from '$components/Split.astro'
import Title from '$components/Title.astro'
import option01 from '$assets/images/option-01.png'
import option02 from '$assets/images/option-02.png'
import option03 from '$assets/images/option-03.png'
import ad11 from '$assets/images/ads/ad-11.jpg'
import ad12 from '$assets/images/ads/ad-12.png'
import ad11video from '$assets/videos/ads/larios.mp4'
import ad12video from '$assets/videos/ads/holamotor.mp4'

const title = 'Votaciones'
const variation = 3
const linkPrev = { name: 'Volver', path: '/biznaga-de-plata' }
const linkPrevMobile = { name: 'Volver', path: '/biznaga-de-plata' }

const ads = [{ image: ad11, url: '#', video: ad11video }]
const adsMobile = [
	{ image: ad11, url: '#', video: ad11video },
	{ image: ad12, url: 'https://www.peparevuelo.com', video: ad12video },
]
---

<Layout {title} {variation} {linkPrev} {linkPrevMobile} {adsMobile}>
	<span class="absolute inset-0 -z-20 bg-blue-100"></span>
	<Split {variation} {ads} reverse>
		<div class="grid gap-12 lg:grid-cols-2 2xl:gap-24">
			<div>
				<Title class="text-center text-blue-600">¡Vota por tu favorito!</Title>
				<p class="mb-12 mt-6">¿Quién crees que merece ser reconocido con la Biznaga de Plata que cada año entrega COPE Málaga?</p>
				<form id="votingForm">
					<div class="mb-6 grid gap-6">
						<label class="flex items-center gap-3">
							<Image class="w-16 shrink-0 rounded-full" src={option01} width="90" densities={[2]} alt="" />
							<div class="flex grow cursor-pointer items-center gap-3 rounded border border-white bg-white p-3 shadow has-[:checked]:border-lime-500">
								<input class="size-4 cursor-pointer accent-lime-600" type="radio" name="votacion" value="1" required />
								<div class="flex flex-col">
									<span>CERVEZAS SAN MIGUEL</span>
									<span class="text-xs text-lime-600">Por su histórica vinculación a la Feria de Málaga</span>
								</div>
							</div>
						</label>
						<label class="flex items-center gap-3">
							<Image class="w-16 shrink-0 rounded-full" src={option02} width="90" densities={[2]} alt="" />
							<div class="flex grow cursor-pointer items-center gap-3 rounded border border-white bg-white p-3 shadow has-[:checked]:border-lime-500">
								<input class="size-4 cursor-pointer accent-lime-600" type="radio" name="votacion" value="2" />
								<div class="flex flex-col">
									<span>DIANA NAVARRO</span>
									<span class="text-xs text-lime-600">Por su vinculación a la cultura y la Feria de Málaga</span>
								</div>
							</div>
						</label>
						<label class="flex items-center gap-3">
							<Image class="w-16 shrink-0 rounded-full" src={option03} width="90" densities={[2]} alt="" />
							<div class="flex grow cursor-pointer items-center gap-3 rounded border border-white bg-white p-3 shadow has-[:checked]:border-lime-500">
								<input class="size-4 cursor-pointer accent-lime-600" type="radio" name="votacion" value="3" />
								<div class="flex flex-col">
									<span>HOSPITAL REGIONAL DE MÁLAGA</span>
									<span class="text-xs text-lime-600">Por cuidar de miles de personas durante la Feria de Málaga</span>
								</div>
							</div>
						</label>
					</div>
					<div class="text-center">
						<button type="submit" class="rounded bg-blue-600 px-12 py-2 text-lg text-white">Votar</button>
					</div>
				</form>
				<div id="confirmationMessage" class="mt-4 hidden text-center"></div>
			</div>
			<div class="relative">
				<div class="overflow-y-auto bg-white p-6 lg:absolute lg:size-full 2xl:p-12">
					<h2 class="mb-3 text-2xl text-blue-600">Palmarés</h2>
					<ul class="grid gap-3">
						<li>2023: Metro Málaga</li>
						<li>2022: Área de Seguridad del Ayuntamiento de Málaga</li>
						<li>2019: Peña Flamenca Juan Breva, con motivo de su centenario</li>
						<li>2018: Servicios Operativos del Ayuntamiento de Málaga</li>
						<li>2017: Organizadores del Concurso de Atalaje Memorial “Juan Alda”</li>
						<li>2016: Hotel AC Málaga Palacio, con motivo de su 50 aniversario</li>
						<li>2015: Dani Rovira, pregonero de la Feria de Málaga</li>
						<li>2014: Horacio Oliva Muñoz, cirujano de la plaza de toros</li>
						<li>2013: Antonio de la Torre, pregonero de la Feria de Málaga</li>
						<li>2012: Diario SUR, con motivo de su 75 aniversario</li>
						<li>2011: Jeque Al Thani, por la clasificación del Málaga CF en la Champions League</li>
						<li>2010: Manuel Alcántara</li>
						<li>2009: Carmen Thyssen, por el anuncio del Museo Carmen Thyssen Málaga</li>
						<li>2008: Antonio Rodríguez, creador de Espectáculos Mundo, a título póstumo</li>
						<li>2007: Empresa Concesionaria Plaza de Toros Málaga</li>
						<li>2006: MTV Málaga Summer, por el concierto inaugural de la feria</li>
						<li>2005: Consejo Regulador Denominación de Origen Málaga</li>
						<li>2004: Julio Iglesias, pregonero de la Feria de Málaga</li>
						<li>2003: Antonio Garrido, pregonero de la Feria de Málaga</li>
						<li>2002: Empresa Malagueña de Transportes</li>
						<li>2001: Eugenio Chicano, autor de la portada de calle Larios</li>
						<li>2000: Melanie Griffith</li>
						<li>1999: Asociación Cultural y Recreativa El Portón</li>
						<li>1998: Antonio Valero Navarrete, arquitecto de recinto ferial de Cortijo de Torres</li>
						<li>1997: Asociación Centro Histórico de Málaga</li>
						<li>1996: Chiquito de la Calzada, pregonero de la Feria de Málaga</li>
						<li>1995: Limasa</li>
					</ul>
				</div>
			</div>
		</div>
	</Split>
</Layout>

<script type="module">
	// Importar las funciones necesarias de Firebase
	import { initializeApp } from 'https://www.gstatic.com/firebasejs/9.10.0/firebase-app.js'
	import { getFirestore, collection, addDoc } from 'https://www.gstatic.com/firebasejs/9.10.0/firebase-firestore.js'

	// Tu configuración de Firebase
	const firebaseConfig = {
		apiKey: 'AIzaSyDkGy0uIVWvJZI2YrOs1ff8rZDGyrywPzU',
		authDomain: 'votacion-cope.firebaseapp.com',
		projectId: 'votacion-cope',
		storageBucket: 'votacion-cope.appspot.com',
		messagingSenderId: '651375602367',
		appId: '1:651375602367:web:20abc436bc60707cb8b40a',
		measurementId: 'G-QE1B1D9173',
	}

	// Inicializar Firebase
	const app = initializeApp(firebaseConfig)
	const db = getFirestore(app)
	const votosCollection = collection(db, 'votos')

	document.getElementById('votingForm').addEventListener('submit', async e => {
		e.preventDefault()
		const formData = new FormData(e.target)
		const votacion = formData.get('votacion')
		const confirmationMessage = document.getElementById('confirmationMessage')

		// Verificar si el usuario ya ha votado
		if (localStorage.getItem('hasVoted')) {
			confirmationMessage.textContent = 'Ya has votado anteriormente.'
			confirmationMessage.className = 'mt-4 text-center text-red-600'
			confirmationMessage.classList.remove('hidden')
			return
		}

		try {
			await addDoc(votosCollection, {
				votacion: votacion,
				timestamp: new Date(),
			})
			// Guardar un indicador en LocalStorage
			localStorage.setItem('hasVoted', 'true')
			confirmationMessage.textContent = '¡Voto registrado exitosamente!'
			confirmationMessage.className = 'mt-4 text-center text-green-600'
			confirmationMessage.classList.remove('hidden')
		} catch (e) {
			console.error('Error al registrar el voto: ', e)
			confirmationMessage.textContent = 'Hubo un error al registrar el voto.'
			confirmationMessage.className = 'mt-4 text-center text-red-600'
			confirmationMessage.classList.remove('hidden')
		}
	})
</script>
