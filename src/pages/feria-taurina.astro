---
import { Image } from 'astro:assets'
import Layout from '$layouts/Layout.astro'
import Split from '$components/Split.astro'
import Title from '$components/Title.astro'
import cartel from '$assets/images/cartel.webp'
import ad29 from '$assets/images/ads/ad-29.jpg'
import ad14 from '$assets/images/ads/ad-14.jpg'
import ad29video from '$assets/videos/ads/casino.mp4'

const title = 'Feria Taurina'
const variation = 3
const linkPrev = { name: '150 Años la Malagueta', path: '/publicidad-3' }
const linkPrevMobile = { name: '150 Años la Malagueta', path: '/150-anos-la-malagueta' }
const adsMobile = [
	{ image: ad29, url: '#', video: ad29video },
	{ image: ad14, url: 'https://famadesa.es' },
]
---

<Layout {title} {variation} {linkPrev} {linkPrevMobile} {adsMobile}>
	<Split {variation} ads={[]} reverse>
		<Fragment slot="aside">
			<Image src={cartel} width={584} densities={[2]} alt="" />
		</Fragment>

		<div class="mx-auto xl:max-w-2xl">
			<Title class="text-center text-blue-600">La Feria Taurina de Málaga rinde tributo a Paquirri a los 40 años de su muerte</Title>
			<div class="prose my-12">
				<p>
					Del 14 al 20 de agosto, la Plaza de Toros de La Malagueta se convierte en escenario de la Feria Taurina de Málaga 2024, que rinde homenaje a Francisco
					Rivera 'Paquirri', con motivo del 40 aniversario de su fallecimiento. En cartel, cinco corridas de toros, entre ellas la Picassiana que protagonizará
					Cayetano Rivera, hijo de Paquirri; un mano a mano entre Roca Rey y Jiménez Fortes y la despedida de Enrique Ponce. Completan la propuesta de la Feria
					Taurina de Málaga 2024 una novillada con picadores y una corrida de rejones.
				</p>
			</div>
			<p class="mb-3 text-blue-600">En colaboración con</p>
			<a target="_blank" href="https://famadesa.es/">
				<Image src={ad14} width={672} densities={[2]} alt="" />
			</a>
		</div>
	</Split>
</Layout>
