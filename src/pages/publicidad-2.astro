---
import { Image } from 'astro:assets'
import Layout from '$layouts/Layout.astro'
import AdSlot from '$components/AdSlot.astro'
import { showAds } from '$utils/config'
import ad25 from '$assets/images/ads/ad-25.jpg'
import ad26 from '$assets/images/ads/ad-26.jpg'
import ad25video from '$assets/videos/ads/activa.mp4'
import ad26video from '$assets/videos/ads/ags.mp4'

const title = 'Publicidad 2'
const variation = 1
const linkPrev = { name: 'Carteles de Feria', path: '/carteles-de-feria' }
const linkNext = { name: 'El vino y la Feria', path: '/el-vino-y-la-feria' }
const linkPrevMobile = { name: 'Carteles de Feria', path: '/carteles-de-feria' }
const linkNextMobile = { name: 'El vino y la Feria', path: '/el-vino-y-la-feria' }

const slots = [
	{ spot: 71, image: ad25, video: ad25video },
	{ spot: 72, image: ad26, video: ad26video },
]
---

<Layout {title} {variation} {linkPrev} {linkNext} {linkPrevMobile} {linkNextMobile}>
	<span class="absolute inset-0 bg-blue-600"></span>
	<div class="container relative py-24 text-white">
		<div class="grid gap-12 md:grid-cols-2 xl:gap-24">
			{
				slots.map(({ spot, image, video }) => (
					<div class="mx-auto max-w-144">
						<p>{showAds ? 'En colaboración con' : 'Publicidad'}</p>
						{showAds ? (
							<a class="open-in-modal group" target="_blank" href={video}>
								<Image class="mt-3 aspect-square rounded object-cover" src={image} width={576} densities={[2]} alt="" />
							</a>
						) : (
							<AdSlot class="mt-3" spot={spot} video={!!video} />
						)}
					</div>
				))
			}
		</div>
	</div>
</Layout>
