---
import { Image } from 'astro:assets'
import Layout from '$layouts/Layout.astro'
import ad25 from '$assets/images/ads/ad-25.jpg'
import ad26 from '$assets/images/ads/ad-26.jpg'
import ad25video from '$assets/videos/ads/activa.mp4'
import ad26video from '$assets/videos/ads/ags.mp4'

const title = 'Publicidad 2'
const variation = 1
const linkPrev = { name: 'Cómete la Feria', path: '/comete-la-feria' }
const linkNext = { name: 'Mapa Interactivo', path: '/mapa-interactivo' }
const linkPrevMobile = { name: 'Cómete la Feria', path: '/comete-la-feria' }
const linkNextMobile = { name: 'Mapa Interactivo', path: '/mapa-interactivo' }
---

<Layout {title} {variation} {linkPrev} {linkNext} {linkPrevMobile} {linkNextMobile}>
	<span class="absolute inset-0 bg-blue-600"></span>
	<div class="container relative py-24 text-white">
		<div class="grid gap-12 md:grid-cols-2 xl:gap-24">
			<div class="mx-auto max-w-144">
				<p>En colaboración con</p>
				<a class="open-in-modal group" target="_blank" href={ad25video}>
					<Image class="mt-3 aspect-square rounded object-cover" src={ad25} width={576} densities={[2]} alt="" />
				</a>
			</div>
			<div class="mx-auto max-w-144">
				<p>En colaboración con</p>
				<a class="open-in-modal group" target="_blank" href={ad26video}>
					<Image class="mt-3 aspect-square rounded object-cover" src={ad26} width={576} densities={[2]} alt="" />
				</a>
			</div>
		</div>
	</div>
</Layout>
