---
import { Image, getImage } from 'astro:assets'
import Layout from '$layouts/Layout.astro'
import Split from '$components/Split.astro'
import ad05 from '$assets/images/ads/ad-05.jpg'
import ad06 from '$assets/images/ads/ad-06.jpg'
import ad07 from '$assets/images/ads/ad-07.png'
import ad08 from '$assets/images/ads/ad-08.png'
import journals from '$utils/data-journals'
import ad06video from '$assets/videos/ads/torremolinos.mp4'
import ad07video from '$assets/videos/ads/muelle.mp4'
import ad08video from '$assets/videos/ads/molina.mp4'

const title = 'Revistas anteriores'
const variation = 4
const linkPrev = { name: 'Volver', path: '/revista-de-feria' }
const linkPrevMobile = { name: 'Volver', path: '/revista-de-feria' }

const ads = [
	{ spot: 17, image: ad05, url: 'https://emtsam.org' },
	{ spot: 18, image: ad06, url: '#', video: ad06video },
	{ spot: 19, image: ad07, url: '#', video: ad07video },
]
const adsMobile = [
	{ spot: 20, image: ad07, url: 'https://emtsam.org', video: ad07video },
	{ spot: 21, image: ad08, url: 'https://www.tesesa.com', video: ad08video },
]
const modalAd = { spot: 22, image: ad08, url: 'https://www.tesesa.com', video: ad08video }
---

<Layout {title} {variation} {linkPrev} {linkPrevMobile} {adsMobile} {modalAd}>
	<Split {variation} {ads}>
		<h1 class="mb-12 text-2xl text-blue-600">{title}</h1>
		<div class="grid max-w-4xl grid-cols-2 gap-6 sm:grid-cols-3 xl:grid-cols-4 2xl:gap-12">
			{
				journals.map(async ({ image, name }) => (
					<article class="max-2xl:text-sm">
						<h3 class="text-neutral-500">{name}</h3>
						<Image class="mb-3 mt-1 aspect-[2/3] w-full rounded object-cover" src={image} width="220" densities={[2]} alt="" />
						<div class="flex justify-center gap-2 text-center text-blue-600">
							<a class="open-in-modal underline hover:text-orange-600" target="_blank" href={(await getImage({ src: image, format: 'webp' })).src}>
								Ver
							</a>
						</div>
					</article>
				))
			}
		</div>
	</Split>
</Layout>
