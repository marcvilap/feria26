---
import { Image } from 'astro:assets'
import Layout from '$layouts/Layout.astro'
import Split from '$components/Split.astro'
import ad16 from '$assets/images/ads/ad-16.jpg'
import recommendations from '$utils/data-recommendations'
import ad16video from '$assets/videos/ads/costa-sol.mp4'

const title = 'Recomedaciones'
const variation = 4
const linkPrev = { name: 'Volver', path: '/comete-la-feria' }
const linkPrevMobile = { name: 'Volver', path: '/comete-la-feria' }
const ads = [{ image: ad16, url: '#', video: ad16video }]
---

<Layout {title} {variation} {linkPrev} {linkPrevMobile}>
	<Split {variation} {ads}>
		<h1 class="mb-12 text-2xl text-blue-600">Cómete la feria</h1>
		<nav class="grid gap-x-6 gap-y-12 sm:grid-cols-2 xl:gap-x-12 2xl:gap-x-24">
			{
				recommendations.map(({ image, name, description, path }) => (
					<a class="group" href={path}>
						<div class="overflow-clip rounded bg-black">
							<Image class="w-full transition group-hover:scale-110 group-hover:opacity-75" src={image} width="428" densities={[2]} alt="" />
						</div>
						<h2 class="mt-3 text-xl uppercase xl:text-2xl">{name}</h2>
						<p class="text-neutral-500 xl:text-lg">{description}</p>
					</a>
				))
			}
		</nav>
	</Split>
</Layout>
