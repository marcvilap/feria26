---
import { Image } from 'astro:assets'
import Layout from '$layouts/Layout.astro'
import Split from '$components/Split.astro'
import Title from '$components/Title.astro'
import Map from '$components/Map.astro'
import Icon from '$components/Icon.astro'
import CasetaSearch from '$components/CasetaSearch.astro'
import map02 from '$assets/images/map-02.webp'
import cenefa from '$assets/images/cartojal-fondo.svg'
import { ad, adsFor } from '$utils/data-ads'

const title = 'Mapa de la feria'
const variation = 3
// Última sección del recorrido: no lleva enlace "siguiente".
const linkPrev = { name: 'Plaza de Toros', path: '/plaza-de-toros' }
const linkPrevMobile = { name: 'Plaza de Toros', path: '/plaza-de-toros' }
const ads = [ad(78)]
const adsMobile = adsFor(79, 80)
---

<Layout {title} {variation} {linkPrev} {linkPrevMobile} {adsMobile}>
	{
		/* La sección la patrocina Cartojal y va con su fondo, como en 2025: el fucsia de la
		marca y encima su cenefa, una sola vez y muy suave, no una trama repetida.
		Ver PUBLICIDAD.md, «Mapa Interactivo». */
	}
	<span class="absolute inset-0 -z-20 bg-cartojal"></span>
	{/* El 28% es el ancho del panel azul fijo del Layout: la cenefa arranca justo donde acaba. */}
	<img class="absolute inset-x-0 top-24 -z-10 w-full opacity-25 lg:left-[28%] lg:w-[72%]" src={cenefa.src} alt="" />
	<Split {variation} {ads} reverse>
		<Fragment slot="aside">
			<Title class="-mt-12 mb-6 max-w-64 text-white max-lg:hidden">{title}</Title>
		</Fragment>
		<Title class="mb-6 text-white lg:hidden">{title}</Title>
		<Icon class="mb-6 w-64 text-white lg:w-80" name="cartojal" />
		<div class="mb-12"><CasetaSearch /></div>
		<div class="grid items-start gap-12 sm:flex">
			<div class="basis-1/3">
				<Image class="w-full" src={map02} width={301} densities={[2]} alt="" />
			</div>
			<div class="basis-2/3 max-sm:-ml-40 max-sm:-mr-32 max-sm:-rotate-[4deg] lg:-mt-24">
				<Map />
			</div>
		</div>
	</Split>
</Layout>
