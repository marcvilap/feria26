---
import Layout from '$layouts/Layout.astro'
import Split from '$components/Split.astro'
import Title from '$components/Title.astro'
import VideoGrid from '$components/VideoGrid.astro'
import ad01 from '$assets/images/ads/ad-01.jpg'
import ad02 from '$assets/images/ads/ad-02.jpg'
import ad01video from '$assets/videos/ads/unicaja.mp4'
import test from '$utils/data-test'

const title = 'Test de la Feria'
const variation = 4
const linkPrev = { name: 'Te lo cuenta COPE', path: '/te-lo-cuenta' }
const linkNext = { name: '60 Aniversario', path: '/60-aniversario' }
const linkPrevMobile = { name: 'Te lo cuenta COPE', path: '/te-lo-cuenta' }
const linkNextMobile = { name: '60 Aniversario', path: '/60-aniversario' }
const ads = [{ spot: 52, image: ad01, url: '#', video: ad01video }]
const adsMobile = [
	{ spot: 53, image: ad01, url: '#', video: ad01video },
	{ spot: 54, image: ad02, url: 'https://www.tesesa.com/' },
]
// La sección pasa de 4 a 19 vídeos y solo tenía reservados los pop-ups 55-58. Con la
// numeración congelada, los cuatro que ya estaban conservan su hueco y los quince que
// se añaden estrenan número: ya no quedaban libres de los intersticiales, así que van
// del 91 en adelante (ver PUBLICIDAD.md). El orden sigue al de la parrilla.
// prettier-ignore
const modalAd = {
	spot: 55,
	spots: [55, 56, 57, 58, 91, 92, 93, 96, 97, 98, 99, 100, 101, 102, 103, 104, 105, 106, 107],
	image: ad02,
	url: 'https://www.tesesa.com/',
}
---

<Layout {title} {variation} {linkPrev} {linkNext} {linkPrevMobile} {linkNextMobile} {adsMobile} {modalAd}>
	<Split {variation} {ads}>
		<Title class="text-blue-600">{title}</Title>
		<div class="prose my-12 max-w-2xl">
			<p>
				La Feria de Málaga se vive en sus calles, en sus casetas… y también a través de quienes mejor representan el espíritu de nuestra ciudad. En esta sección
				reunimos una divertida serie de vídeos protagonizados por rostros muy conocidos de Málaga, que se han atrevido a enfrentarse a un test muy especial
				sobre la feria.
			</p>
			<p>
				Anécdotas, curiosidades, tradiciones y alguna que otra pregunta inesperada pondrán a prueba sus conocimientos y su sentido del humor. Descubre sus
				respuestas, sorpréndete con sus confesiones y disfruta de una forma diferente de conocer a estos personajes. Porque, cuando se habla de la Feria de
				Málaga, siempre hay espacio para compartir una sonrisa.
			</p>
		</div>
		<VideoGrid adSpot={modalAd.spots} items={test} columns={2} />
	</Split>
</Layout>
