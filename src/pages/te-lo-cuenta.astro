---
import Layout from '$layouts/Layout.astro'
import Split from '$components/Split.astro'
import Title from '$components/Title.astro'
import VideoGrid from '$components/VideoGrid.astro'
import teLoCuenta from '$utils/data-te-lo-cuenta'
import { adsFor, adsForMobile } from '$utils/data-ads'

// Unifica el texto de apertura y la subpágina de vídeos en una sola sección.
const title = 'Te lo cuenta COPE Málaga'
const variation = 2
const linkPrev = { name: 'Curiosidades', path: '/curiosidades' }
const linkNext = { name: 'Test de la Feria', path: '/test-de-la-feria' }
const linkPrevMobile = { name: 'Curiosidades', path: '/curiosidades' }
const linkNextMobile = { name: 'Test de la Feria', path: '/test-de-la-feria' }
const ads = adsFor(43, 44)
const adsMobile = adsForMobile(ads)
// Un hueco por pieza, en el mismo orden que la parrilla. La sección solo tenía
// reservados los pop-ups 47-51 y ya va por once piezas, así que la numeración sale a
// trompicones: las cinco de 2026 conservan su hueco; las tres nuevas de agosto estrenan
// los reservados 94 y 95 y, agotados esos, el 110; y las tres recuperadas de 2025 se
// quedan con 84, 85 y 90, que es lo importante porque están vendidos y moverlos les
// cambiaría el vídeo al anunciante.
const modalSpots = [47, 48, 49, 50, 51, 94, 95, 110, 84, 85, 90]
const modalAds = adsFor(...modalSpots)
---

<Layout {title} {variation} {linkPrev} {linkNext} {linkPrevMobile} {linkNextMobile} {adsMobile} {modalAds}>
	<div class="lg:h-40"></div>
	<Split {variation} {ads}>
		<div class="relative lg:mb-8 lg:-translate-y-40">
			<Title class="text-white max-sm:-mr-3">Te lo cuenta COPE Málaga</Title>
		</div>

		<div class="prose mb-12 max-w-2xl">
			<p>
				Los periodistas de COPE Málaga salen a la calle para contarte la feria desde dentro. El flamenco, los fuegos artificiales, el transporte público o los
				rincones que hacen única la semana grande de la ciudad, explicados por quienes la narran cada agosto en antena.
			</p>
		</div>

		<VideoGrid adSpot={modalSpots} items={teLoCuenta} />
	</Split>
</Layout>
