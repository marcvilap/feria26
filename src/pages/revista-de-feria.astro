---
import Layout from '$layouts/Layout.astro'
import Split from '$components/Split.astro'
import JournalGrid from '$components/JournalGrid.astro'
import { ad, adsFor } from '$utils/data-ads'

// Unifica las dos secciones de 2025: "Bienvenida" (texto de apertura y acceso a
// las ediciones anteriores) y "Feria y sociedad" (los testimonios en vídeo).
const title = 'Revista de Feria'
const variation = 3
const linkPrev = { name: 'El vino y la Feria', path: '/el-vino-y-la-feria' }
const linkNext = { name: 'Biznaga de Plata', path: '/biznaga-de-plata' }
const linkPrevMobile = { name: 'El vino y la Feria', path: '/el-vino-y-la-feria' }
const linkNextMobile = { name: 'Biznaga de Plata', path: '/biznaga-de-plata' }
const ads = [ad(2)]
const adsMobile = adsFor(3, 4)
// Sin publicidad en los pop-ups: «en las revistas no hay anuncios» (Mónica, 13/08/2026).
// Aquí había doce huecos (5-16), heredados de cuando la parrilla eran los testimonios en
// vídeo. Nunca llegaron a pintarse —`JournalGrid` no emitía `data-ad-spot`— y además no
// cuadraban: doce huecos para veinticinco portadas. Se retiran. Los laterales y los de
// móvil siguen, que esos sí son de la página.
---

<Layout {title} {variation} {linkPrev} {linkNext} {linkPrevMobile} {linkNextMobile} {adsMobile}>
	<Split {variation} {ads} reverse>
		<div>
			{
				/* Antes aquí iba la parrilla de testimonios en vídeo (`data-revista`). La clienta
				   pidió el 11/08/2026 que al entrar en «Revista de Feria» aparezcan las
				   «Revistas anteriores», no los vídeos del test del año pasado. Los vídeos
				   siguen en `src/utils/data-revista.ts` por si se recolocan en otra sección.

				   El 13/08/2026 pidió además quitar de aquí el texto de apertura («Una feria y
				   muchas maneras de disfrutarla» y los párrafos que venían de 2025), así que la
				   sección se queda solo con la galería. */
			}
			<h2 class="mb-8 font-condensed text-3xl font-bold uppercase text-blue-600">Revistas anteriores</h2>
			<JournalGrid />
		</div>
	</Split>
</Layout>
