---
import { Image } from 'astro:assets'
import Icon from '$components/Icon.astro'

interface Item {
	/**
	 * Sin vídeo la pieza se publica igual, con un marcador de «pendiente de entrega» en
	 * lugar de la miniatura. Así el cliente ve en la propia web qué le falta por mandar,
	 * sin tener que mirar ningún listado.
	 */
	video?: string
	image?: ImageMetadata
	name: string
	description?: string
}

interface Props {
	items: Item[]
	columns?: 2 | 3
	class?: string
	/**
	 * Huecos publicitarios de pop-up de la página. Con un número, cada vídeo consume
	 * el siguiente correlativo. Con una lista, cada vídeo toma el hueco de su misma
	 * posición: se usa cuando la numeración está congelada y los huecos de una sección
	 * ya no son correlativos (ver PUBLICIDAD.md).
	 */
	adSpot?: number | number[]
}

const { items, columns = 3, class: className, adSpot } = Astro.props

const spotFor = (index: number) => (Array.isArray(adSpot) ? adSpot[index] : adSpot ? adSpot + index : undefined)

const initials = (name: string) =>
	name
		.split(' ')
		.filter(word => word.length > 2)
		.slice(0, 2)
		.map(word => word[0])
		.join('')
---

<div class:list={['grid grid-cols-2 gap-x-3 gap-y-6 sm:gap-x-6', columns === 3 ? 'xl:grid-cols-3' : 'xl:gap-x-12', className]}>
	{
		items.map(({ video, image, name, description }, index) =>
			video ? (
				<a class="open-in-modal group" target="_blank" href={video} data-ad-spot={spotFor(index)}>
					<div class="relative flex aspect-video items-center justify-center overflow-clip rounded bg-black">
						{image ? (
							<Image
								class="size-full object-cover opacity-75 transition group-hover:scale-110 group-hover:opacity-50"
								src={image}
								width="592"
								densities={[2]}
								alt=""
							/>
						) : (
							<span class="absolute inset-0 flex items-center justify-center bg-gradient-to-br from-blue-600 to-blue-800 font-condensed text-6xl font-bold uppercase text-white/20 transition group-hover:scale-110">
								{initials(name)}
							</span>
						)}
						<span class="absolute flex size-12 items-center justify-center rounded-full border-2 border-current text-white 2xl:size-16">
							<Icon class="w-6" name="play" />
						</span>
					</div>
					<h3 class="mt-3 text-xl xl:text-2xl">{name}</h3>
					{description && <div class="text-sm text-neutral-500">{description}</div>}
				</a>
			) : (
				<div>
					<div class="flex aspect-video flex-col items-center justify-center gap-1 rounded border-2 border-dashed border-orange-600 px-4 text-center font-condensed uppercase leading-none text-orange-600">
						<span class="text-lg font-bold tracking-wider">Vídeo pendiente</span>
						<span class="text-xs tracking-wide">de entrega</span>
					</div>
					<h3 class="mt-3 text-xl text-neutral-500 xl:text-2xl">{name}</h3>
					{description && <div class="text-sm text-neutral-500">{description}</div>}
				</div>
			),
		)
	}
</div>
