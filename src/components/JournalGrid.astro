---
import { Image, getImage } from 'astro:assets'
import journals from '$utils/data-journals'

// La galería de portadas de las revistas anteriores. Vivía suelta dentro de
// `revista-de-feria/revistas.astro`; se saca aquí porque desde el 11/08/2026 se
// pinta en dos sitios: en esa página y en la portada de «Revista de Feria»,
// que es donde la clienta espera encontrarla.
//
// El 13/08/2026 Mónica pidió que la portada se pinche y se abra, como en Carteles de
// Feria: por eso el marcado de la portada es el mismo que el de `carteles-de-feria.astro`.
//
// Debajo va el «Descargar» de la revista completa, pero solo hasta 2023: desde 2024 la
// edición es digital y no hay PDF (ver `data-journals.ts`). Las descargas no pasan por
// el pop-up, son un enlace normal al PDF.
---

<div class="grid max-w-4xl grid-cols-2 gap-6 sm:grid-cols-3 xl:grid-cols-4 2xl:gap-12">
	{
		journals.map(async ({ image, name, pdf }) => (
			<article>
				<a class="open-in-modal group" target="_blank" href={(await getImage({ src: image, format: 'webp' })).src}>
					<div class="overflow-clip rounded bg-black">
						<Image
							class="aspect-[2/3] w-full object-cover transition group-hover:scale-110 group-hover:opacity-50"
							src={image}
							width="220"
							densities={[2]}
							alt=""
						/>
					</div>
					<h3 class="mt-3 text-center">{name}</h3>
				</a>
				{pdf && (
					<a class="mt-1 block text-center text-sm text-blue-600 underline hover:text-orange-600" href={pdf} target="_blank" rel="noopener noreferrer">
						Descargar revista
					</a>
				)}
			</article>
		))
	}
</div>
