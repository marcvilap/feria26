---
/**
 * Chapa de revisión que se superpone a una creatividad ya montada con el número de
 * hueco y el nombre del anunciante, para poder cotejar de un vistazo contra el Excel
 * del comercial que cada anuncio ha caído donde tocaba.
 *
 * Es temporal: se apaga entero con `showAdNumbers` en `$utils/config`. Los huecos sin
 * vender no la necesitan, porque ya se pintan con su número (ver `AdSlot`).
 *
 * El contenedor que lo envuelve tiene que ser `relative`.
 */
import type { Ad } from '$utils/ads'

interface Props {
	ad: Ad
}

const { ad } = Astro.props
---

<span
	class="pointer-events-none absolute left-0 top-0 z-10 flex items-baseline gap-1.5 rounded-br rounded-tl bg-black/70 px-2 py-1 text-left font-condensed uppercase leading-none text-white backdrop-blur"
>
	<span class="text-base font-bold tracking-wider">{String(ad.spot).padStart(2, '0')}</span>
	{ad.name && <span class="max-w-32 truncate text-[0.6rem] tracking-wide text-white/80">{ad.name}</span>}
</span>
