>
	<span class="absolute left-12 top-6 text-[9rem] font-bold uppercase text-blue-800 2xl:left-24 2xl:top-0 2xl:text-[17rem]">Menú</span>

	<menu class="relative flex flex-col items-start gap-4 overflow-y-auto p-12 text-3xl text-white 2xl:gap-6 2xl:p-24 2xl:text-4xl">
