---
import Icon from '$components/Icon.astro'
---

<button
	id="caseta-search-open"
	class="inline-flex items-center gap-3 rounded-full border-2 border-blue-600 px-6 py-3 font-condensed text-lg font-bold uppercase text-blue-600 transition-colors hover:bg-blue-600 hover:text-white"
>
	<span class="size-5"><Icon name="search" /></span>
	Buscar caseta
</button>

<dialog id="caseta-search" class="w-full max-w-lg rounded bg-white p-6 text-left 2xl:p-8">
	<button id="caseta-search-close" class="absolute right-4 top-4 flex size-8 items-center justify-center rounded-full text-blue-600 hover:bg-blue-100">
		<span class="absolute w-4 rotate-45 border-t-2 border-current"></span>
		<span class="absolute w-4 -rotate-45 border-t-2 border-current"></span>
	</button>

	<h2 class="font-condensed text-2xl font-bold uppercase text-blue-600">Buscar caseta</h2>
	<p class="mb-4 mt-1 text-sm text-neutral-500">Escribe al menos 3 letras del nombre y te la señalamos en el mapa.</p>

	<input
		id="caseta-search-input"
		type="search"
		autocomplete="off"
		placeholder="Por ejemplo: pim, peña, larios…"
		class="w-full rounded border border-neutral-300 px-4 py-3 text-lg outline-none focus:border-blue-600"
	/>

	<p id="caseta-search-hint" class="mt-3 text-sm text-neutral-500"></p>
	<ul id="caseta-search-results" class="mt-3 max-h-72 overflow-y-auto"></ul>
</dialog>
