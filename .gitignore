# large assets (exceed GitHub 100MB limit, kept out of the repo)
src/assets/pdfs/

# Los vídeos 2026 ya están reencodeados con `npm run videos` y ninguno llega
# a los 100MB de GitHub, así que entran en el repo.

# material original entregado por el cliente (~4,9 GB en ZIP)
nuevo/

# caché del script de compresión
scripts/.videos-cache.json

# caché de los scripts de Python
scripts/__pycache__/

# build output
dist/
.vercel/

# generated types
.astro/

# dependencies
node_modules/

# logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# environment variables
.env
.env.production

# macOS-specific files
.DS_Store

# jetbrains setting folder
.idea/

# ajustes personales de Claude Code (los de equipo irían en .claude/settings.json)
.claude/settings.local.json
